# ============================================================
# NoarBeauty AI — Environment Variables
# Kopiraj u .env.local i popuni vrednosti
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SUPABASE ---
# https://supabase.com → New project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# --- STRIPE ---
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_PRO_PRICE_ID=price_...     # kreiraš u Stripe Dashboard → Products
STRIPE_ELITE_PRICE_ID=price_...

# --- PYTHON API ---
# Lokalno: http://localhost:8000 | Produkcija: Railway URL
PYTHON_API_URL=http://localhost:8000

# --- RESEND EMAIL ---
# https://resend.com → besplatan do 3000 email/mes
RESEND_API_KEY=re_...

# --- POSTHOG ANALYTICS ---
# https://posthog.com → besplatan tier
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- SENTRY ERROR TRACKING ---
# https://sentry.io → besplatan tier
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
